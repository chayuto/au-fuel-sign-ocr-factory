# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments
.venv/
.venv-export/
venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Secrets / credentials
.env
.env.*
*.pem
*.key
credentials.json

# Data pipeline
# data/ingest/ is git-tracked — remote scrape agents push raw images here via PR.
# Everything else under data/ is local working data (gold dataset, training
# outputs, labels, annotations, previews, manifests) backed up via /snapshot skill.
data/*
!data/ingest/

# Font downloads (large binaries)
assets/fonts/*.ttf
assets/fonts/*.otf
!assets/fonts/.gitkeep

# Training runs and model artifacts
runs/
*.pt
*.onnx
*.tflite

# Backups (local snapshots, never commit)
backups/

# Models (HuggingFace local copy)
models/

# Node modules
node_modules/
package-lock.json

# Jupyter
.ipynb_checkpoints/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
